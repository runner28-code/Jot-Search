{
    "family": "prod-site-frontend-task",
    "executionRoleArn": "arn:aws:iam::484913924231:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "intulsa-frontend-container-prod",
            "image": "site-frontend:prod",
            "cpu": 1024,
            "memory": 2048,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                   "awslogs-group" : "/ecs/prod-site-frontend-task",
                   "awslogs-region": "us-east-1",
                   "awslogs-stream-prefix": "ecs"
                }
            },
            "environment": [
                {
                    "name": "CHOKIDAR_USEPOLLING",
                    "value": "true"
                }
            ]
        }
    ],
    "cpu": "1024",
    "memory": "2048"
}

{
    "family": "dev-site-frontend-task",
    "executionRoleArn": "arn:aws:iam::484913924231:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "image": "site-frontend:dev",
            "cpu": 1024,
            "memory": 2048,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                   "awslogs-group" : "/ecs/dev-site-frontend-task",
                   "awslogs-region": "us-east-1",
                   "awslogs-stream-prefix": "ecs"

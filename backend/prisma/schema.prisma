  isDeleted             Boolean?
  lastName              String?
  leadSource            String?
  massMailOptOut        Boolean?
  middleName            String?
  mobile                String?
  name                  String?
  namePrefix            String?
  nameSuffix            String?
  nickName              String?
  notes                 Json?
  numEmployees          Int?
  occupation            String?
  owner                 Json?
  ownerCorporation      String?
  pager                 String?
  phone                 String?
  phone2                String?
  phone3                String?
  preferredContact      String?
  primarySkills         String?

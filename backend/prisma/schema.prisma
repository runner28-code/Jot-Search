generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id String @id @default(uuid())

  userId String
  user   User   @relation("userApplications", fields: [userId], references: [id])

  jobId String
  job   Job    @relation("jobApplications", fields: [jobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  dateAdded   DateTime?
  description String?
  enabled     Boolean   @default(true)
  externalID  Int?      @unique
  occupation  String?
  type        String?
  score       Float?    @map("_score")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("userCategory")
  jobs  Job[]  @relation("jobCategory")
  candidates Candidate[] @relation("candidateCategory")
}

model History {
  id       String  @id @default(uuid())
  table    String
  recordId String
  column   String
  oldValue String?
  newValue String?

  batchId String?

  createdAt DateTime @default(now())
}

model Lead {
  id                    String    @id @default(uuid())
  externalId            String?
  address_address1      String?
  address_address2      String?
  address_city          String?
  address_state         String?
  address_zip           String?
  address_country_id    Int?
  campaignSource        String?
  candidates            String?
  category              Json?
  clientContacts        String?
  clientCorporation     Json?
  comments              String?
  companyName           String?
  companyURL            String?
  conversionSource      String?
  dateAdded             DateTime?
  dateLastComment       DateTime?
  dateLastModified      DateTime?
  dateLastVisited       DateTime?
  description           String?
  division              String?
  email                 String?
  email2                String?
  email3                String?
  fax                   String?
  fax2                  String?
  fax3                  String?
  firstName             String?
  isAnonymized          Boolean?
  isDayLightSavingsTime Boolean?
  isDeleted             Boolean?
  lastName              String?
  leadSource            String?
  massMailOptOut        Boolean?
  middleName            String?
  mobile                String?
  name                  String?
  namePrefix            String?
  nameSuffix            String?
  nickName              String?
  notes                 Json?
  numEmployees          Int?
  occupation            String?
  owner                 Json?
  ownerCorporation      String?
  pager                 String?
  phone                 String?
  phone2                String?
  phone3                String?
  preferredContact      String?
  primarySkills         String?
  priority              String?
  referredByPerson      String?
  reportToPerson        String?
  role                  String?
  salary                BigInt?
  salaryLow             BigInt?
  secondarySkills       String?
  skillSet              String?
  smsOptIn              Boolean?
  specialties           String?
  timeZoneOffsetEST     Int?
  type                  String?
  willRelocate          Boolean?
  createdAt             DateTime  @default(now())

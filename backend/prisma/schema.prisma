generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id String @id @default(uuid())

  userId String
  user   User   @relation("userApplications", fields: [userId], references: [id])

  jobId String
  job   Job    @relation("jobApplications", fields: [jobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  dateAdded   DateTime?
  description String?
  enabled     Boolean   @default(true)
  externalID  Int?      @unique
  occupation  String?
  type        String?
  score       Float?    @map("_score")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("userCategory")
  jobs  Job[]  @relation("jobCategory")
  candidates Candidate[] @relation("candidateCategory")
}

model History {
  id       String  @id @default(uuid())
  table    String
  recordId String
  column   String
  oldValue String?
  newValue String?

  batchId String?

  createdAt DateTime @default(now())
}

model Lead {
  id                    String    @id @default(uuid())
  externalId            String?
  address_address1      String?
  address_address2      String?
  address_city          String?
  address_state         String?
  address_zip           String?
  address_country_id    Int?
  campaignSource        String?
  candidates            String?
  category              Json?
  clientContacts        String?
  clientCorporation     Json?
  comments              String?
  companyName           String?
  companyURL            String?
  conversionSource      String?
  dateAdded             DateTime?
  dateLastComment       DateTime?
  dateLastModified      DateTime?
  dateLastVisited       DateTime?
  description           String?
  division              String?
  email                 String?
  email2                String?
  email3                String?
  fax2                  String?
  fax3                  String?
  firstName             String?
  isAnonymized          Boolean?
  isDayLightSavingsTime Boolean?
  isDeleted             Boolean?
  lastName              String?
  leadSource            String?
  massMailOptOut        Boolean?
  middleName            String?
  mobile                String?
  name                  String?
  namePrefix            String?
  nameSuffix            String?
  nickName              String?
  notes                 Json?
  numEmployees          Int?
  occupation            String?
  owner                 Json?
  ownerCorporation      String?
  pager                 String?
  phone                 String?
  phone2                String?
  phone3                String?
  preferredContact      String?
  primarySkills         String?
  priority              String?
  referredByPerson      String?
  reportToPerson        String?
  role                  String?
  salary                BigInt?
  salaryLow             BigInt?
  secondarySkills       String?
  skillSet              String?
  smsOptIn              Boolean?
  specialties           String?
  status                String?
  timeZoneOffsetEST     Int?
  type                  String?
  willRelocate          Boolean?
  createdAt             DateTime  @default(now())
}

model ClientContact {
  id                 String    @id @default(uuid())
  address_address1   String?
  address_address2   String?
  address_city       String?
  address_state      String?
  address_zip        String?
  address_country_id Int?
  category           String?
  certifications     String?
  clientCorporation  String?
  comments           String?
  dateAdded          DateTime?
  dateLastModified   DateTime?
  dateLastVisit      DateTime?
  description        String?
  desiredCategories  String?
  desiredSkills      String?
  desiredSpecialties String?
  division           String?
  email              String?
  email2             String?
  email3             String?
  externalID         String?
  fax                String?
  fax2               String?
  fax3               String?
  firstName          String?
  isAnonymized       Boolean?
  isDayLightSavings  Boolean?
  isDeleted          Boolean?
  lastName           String?
  leads              String?
  middleName         String?
  mobile             String?
  name               String?
  namePrefix         String?
  nameSuffix         String?
  nickName           String?
  numEmployees       Int?
  occupation         String?
  office             String?
  owner              String?
  pager              String?
  password           String?
  phone              String?
  phone2             String?
  phone3             String?
  preferredContact   String?
  skills             String?
  source             String?
  createdAt          DateTime  @default(now())
}

model Company {
  id            String  @id @default(uuid())
  name          String
  annualRevenue BigInt?

  addressId        String?
  billingAddressId String?
  address          Address? @relation("addressCompanies", fields: [addressId], references: [id])
  billingAddress   Address? @relation("billingAddressCompanies", fields: [billingAddressId], references: [id])

  city  String?
  state String?

  billingContact   String?
  billingFrequency String?
  billingPhone     String?

  branchId String?
  branch   Branch? @relation("branchCompanies", fields: [branchId], references: [id])

  invitedCandidates CompanyCandidateInvites[]

  businessSectorList String[]

  companyDescription String?
  companyURL         String?

  // could condsolidate and enrich if needed
  bh_description    String?

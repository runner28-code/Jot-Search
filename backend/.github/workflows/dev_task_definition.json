{
    "family": "dev-site-backend-task", 
    "executionRoleArn": "arn:aws:iam::484913924231:role/ecsTaskExecutionRole", 
    "networkMode": "awsvpc", 
    "containerDefinitions": [
        {
            "name": "intulsa-backend-container-dev", 
            "image": "site-backend:dev", 
            "cpu": 1024, 
            "memory": 2048, 
            "portMappings": [
                {
                    "containerPort": 5000, 
                    "hostPort": 5000, 
                    "protocol": "tcp"
                }
            ], 
            "essential": true,
            "logConfiguration": { 
                "logDriver": "awslogs",
                "options": { 
                   "awslogs-group" : "/ecs/dev-site-backend-task",
                   "awslogs-region": "us-east-1",
                   "awslogs-stream-prefix": "ecs"
                }
            },
            "environment": [
                {
                    "name": "CHOKIDAR_USEPOLLING", 
                    "value": "true"
                },
                {
                    "name": "PORT", 
                    "value": "5000"
                },
                {
                    "name": "PROJECT_ID", 
                    "value": "aerovision-338218"
                },
                {
                    "name": "DATABASE_URL", 
                    "value": "{SECRET_DATABASE_URL}"
                },
